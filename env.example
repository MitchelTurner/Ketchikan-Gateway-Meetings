# --- Railway provides DATABASE_URL when you reference Postgres ---
DATABASE_URL=postgresql://user:pass@localhost:5432/kgb_digest
# Optional. If unset, the Docker image runs Redis in the container and the job queue resets on each deploy.
# To keep jobs across deploys: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# --- Public site ---
PUBLIC_BASE_URL=https://meetings.example.com
PORT=3000
NEWSLETTER_NAME=Ketchikan.Vote

# --- Source ---
ARCHIVE_URL=https://www.kgbak.us/434/Meeting-Video-Archive
# City of Ketchikan council and board videos. Blank skips them.
CITY_YOUTUBE_URL=https://www.youtube.com/@cityofketchikan8631
# Identify yourself to the Borough's server
SCRAPER_USER_AGENT=KGBMeetingDigest/0.1 (+https://meetings.example.com; you@example.com)
# Every 3 hours at :17, Alaska time
DISCOVERY_CRON=17 */3 * * *
TZ_NAME=America/Anchorage
# Meetings dated before this are recorded but not processed. Admin "process" forces one.
# Set it years back to backfill; newer meetings are always processed first.
PROCESS_SINCE=2025-11-01
# Meetings before this are published on /notes but never emailed. Default: 14 days ago.
# EMAIL_SINCE=2026-10-15
# Optional: YouTube cookies (Netscape cookies.txt, base64) if YouTube blocks Railway's IPs
YTDLP_COOKIES_B64=

# --- Transcription: assemblyai (speaker labels, whole file) or openai (whisper, chunked) ---
# YouTube meetings try the video's own captions first, then this provider.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Research: before transcribing, Claude searches the web for the body's roster,
# the meeting agenda, and news coverage. Names feed transcription and the recap.
RESEARCH_ENABLED=true
# RESEARCH_MODEL=claude-sonnet-5-5
# Sites web search may use (comma-separated). Blank = the whole web.
RESEARCH_DOMAINS=kgbak.us,granicus.com,ktn-ak.us,ketchikan.gov,kgbsd.org,ketchikandailynews.com,krbd.org,alaskapublic.org,alaskabeacon.com,adn.com,akleg.gov
# Spellings to always use, "Name — Role; Name — Role"
KNOWN_NAMES=

# --- Email (Resend; verify your sending domain first) ---
# Optional until a transcript looks right. Leave these blank and read /admin/meetings?token=$ADMIN_TOKEN.
RESEND_API_KEY=
EMAIL_FROM=Ketchikan.Vote <recap@meetings.example.com>
# CAN-SPAM requires a physical postal address in every email
MAILING_ADDRESS=PO Box 0000, Ketchikan, AK 99901
EMAIL_RATE_PER_SEC=2
# Review copies + approve links go here
ADMIN_EMAIL=you@example.com
# true = also mark each new recap reviewed as soon as it is written.
# Subscribers are emailed when the recap goes on the site, once Resend is configured, either way.
# No review click. Meetings older than EMAIL_SINCE are never emailed.
AUTO_SEND=false

# --- Ask (questions over published recaps) ---
# A restricted key (rk_) is safer than a secret key (sk_). Needs Customers write,
# Checkout Sessions write, Subscriptions read, Billing Portal write, and Charges read.
# In Stripe, make one Product named Ask with one $5/month Price, and put that Price id here.
# Webhook endpoint: https://YOUR_SITE/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed, charge.dispute.created, charge.refunded,
# radar.early_fraud_warning.created
# Sales tax is off until you have a Stripe Tax registration. See Stripe's guide
# for collecting tax on recurring payments before turning automatic tax on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Security: long random strings (openssl rand -base64 32) ---
ADMIN_TOKEN=
SIGNING_SECRET=
