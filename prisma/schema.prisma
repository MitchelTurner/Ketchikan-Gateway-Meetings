generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  DISCOVERED        // found on the archive, queued
  RESEARCHING       // looking up roster, agenda and news coverage
  SKIPPED           // older than PROCESS_SINCE (use admin retry to force)
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  AWAITING_APPROVAL // recap drafted, waiting for you to approve the send
  SENDING
  SENT
  PUBLISHED         // backfill: approved and on /notes, not emailed
  FAILED
}

model Meeting {
  id          String        @id @default(cuid())
  sourceUrl   String        @unique // canonical video URL
  platform    String
  title       String
  body        String // "Assembly", "Planning Commission", ...
  meetingDate DateTime?
  durationSec Int?
  status      MeetingStatus @default(DISCOVERED)
  error       String?
  research    Research?
  topics      MeetingTopic[]
  topicsAt    DateTime? // when this meeting was last tagged with topics
  transcript  Transcript?
  analysis    Analysis?
  sends       EmailSend[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Research {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  model     String
  data      Json // MeetingContext: people, agenda, terms, articles
  createdAt DateTime @default(now())
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  provider  String
  segments  Json // [{ start, end, speaker?, text }] in seconds
  text      String
  createdAt DateTime @default(now())
}

model Analysis {
  id         String    @id @default(cuid())
  meetingId  String    @unique
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  model      String
  data       Json // MeetingDigest
  approvedAt DateTime?
  hiddenAt   DateTime? // taken off the public site from the admin dashboard
  editedAt   DateTime? // headline or summary changed by hand; automatic rewrites leave it alone
  createdAt  DateTime  @default(now())
}

/** One public page load by a person (bots and the signed-in admin are not counted). */
model PageView {
  id        String   @id @default(cuid())
  kind      String // home | notes | note | meeting | topics | topic
  ref       String? // meeting id or topic slug
  path      String
  referrer  String? // host of an outside site that linked here
  via       String? // invite | sms | email | facebook | copy | share: arrived through a share or invite link
  visitor   String // hash of IP and browser with a daily salt: counts people per day without storing either
  mobile    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, ref])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  status      SubscriberStatus @default(PENDING)
  token       String           @unique // random; used for confirm / unsubscribe links
  bodies      String[] // empty = every body
  topics      String[] // Topic slugs for deep-dive emails; empty = none
  recaps      Boolean          @default(true) // false = topic emails only
  confirmedAt DateTime?
  refCode      String? // personal invite code in /?r=…; made on confirmation. Kept unique in code: a new unique constraint stops `db push` on deploy
  referredById String? // the reader whose invite link they signed up through
  referredBy   Subscriber?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    Subscriber[] @relation("Referrals")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sends       EmailSend[]
  topicSends  TopicSend[]

  @@index([referredById])
  @@index([refCode])
}

enum TopicStatus {
  SUGGESTED // Claude proposed it; waiting for you
  APPROVED  // public page, signup option, deep dives
  ARCHIVED  // hidden; never suggested again
}

/** An issue followed across meetings, e.g. "School budget" or "Ward Cove cruise dock". */
model Topic {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  status      TopicStatus    @default(SUGGESTED)
  meetings    MeetingTopic[]
  deepDives   DeepDive[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

/** What happened on one topic at one meeting. */
model MeetingTopic {
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  summary   String
  t         Float    @default(0) // seconds into the recording
  milestone Boolean  @default(false) // a big development: final vote, budget adopted, contract awarded…
  why       String? // why it counts as a milestone
  createdAt DateTime @default(now())

  @@id([meetingId, topicId])
  @@index([topicId])
}

enum DeepDiveStatus {
  DRAFT    // waiting for your approval
  SENDING
  SENT
  REJECTED
}

/** A single-topic explainer, written when a milestone lands. */
model DeepDive {
  id               String         @id @default(cuid())
  topicId          String
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  triggerMeetingId String
  model            String
  data             Json // DeepDiveArticle
  status           DeepDiveStatus @default(DRAFT)
  approvedAt       DateTime?
  sends            TopicSend[]
  createdAt        DateTime       @default(now())

  @@unique([topicId, triggerMeetingId])
}

model TopicSend {
  id           String     @id @default(cuid())
  deepDiveId   String
  deepDive     DeepDive   @relation(fields: [deepDiveId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       String     @default("queued") // queued | sent | failed
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([deepDiveId, subscriberId])
}

/** One browser that asked to be buzzed when a recap is published. The endpoint is the address; uniqueness is kept in code so db push stays safe. Empty bodies means every meeting. */
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String
  p256dh    String
  auth      String
  bodies    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** The key pair phones use to trust a notification. Created once, on the first install. */
model PushKeys {
  id         String @id
  publicKey  String
  privateKey String
}

model EmailSend {
  id           String     @id @default(cuid())
  meetingId    String
  meeting      Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       String     @default("queued") // queued | sent | failed
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([meetingId, subscriberId])
}
