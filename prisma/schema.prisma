generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  DISCOVERED        // found on the archive, queued
  RESEARCHING       // looking up roster, agenda and news coverage
  SKIPPED           // older than PROCESS_SINCE (use admin retry to force)
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  AWAITING_APPROVAL // recap drafted, waiting for you to approve the send
  SENDING
  SENT
  FAILED
}

model Meeting {
  id          String        @id @default(cuid())
  sourceUrl   String        @unique // canonical video URL
  platform    String
  title       String
  body        String // "Assembly", "Planning Commission", ...
  meetingDate DateTime?
  durationSec Int?
  status      MeetingStatus @default(DISCOVERED)
  error       String?
  research    Research?
  transcript  Transcript?
  analysis    Analysis?
  sends       EmailSend[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Research {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  model     String
  data      Json // MeetingContext: people, agenda, terms, articles
  createdAt DateTime @default(now())
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  provider  String
  segments  Json // [{ start, end, speaker?, text }] in seconds
  text      String
  createdAt DateTime @default(now())
}

model Analysis {
  id         String    @id @default(cuid())
  meetingId  String    @unique
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  model      String
  data       Json // MeetingDigest
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  status      SubscriberStatus @default(PENDING)
  token       String           @unique // random; used for confirm / unsubscribe links
  bodies      String[] // empty = every body
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sends       EmailSend[]
}

model EmailSend {
  id           String     @id @default(cuid())
  meetingId    String
  meeting      Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       String     @default("queued") // queued | sent | failed
  providerId   String?
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([meetingId, subscriberId])
}
